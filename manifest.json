{
  "name": "@demo/ui-kit",
  "version": "0.1.0",
  "component": {
    "name": "Button",
    "module": "packages/ui-kit/src/button/core.ts",
    "createExport": "createButton",
    "coreProps": [
      {
        "name": "label",
        "type": "string",
        "default": "Button"
      },
      {
        "name": "variant",
        "type": "'default' | 'primary' | 'ghost'",
        "default": "'default'"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": false
      }
    ],
    "features": {
      "button.bg-color": {
        "title": "背景色",
        "description": "自定义背景色，并可自动计算前景对比色；引入 chroma-js 做亮度计算。",
        "module": "packages/ui-kit/src/button/features/bg-color/index.ts",
        "exportName": "bgColorFeature",
        "requires": [],
        "props": [
          {
            "name": "bgColor",
            "type": "string"
          },
          {
            "name": "autoContrast",
            "type": "boolean",
            "default": false
          }
        ]
      },
      "button.gradient": {
        "title": "渐变背景",
        "description": "在背景色之上生成渐变，补充渐变角度属性；依赖背景色特性。",
        "module": "packages/ui-kit/src/button/features/gradient/index.ts",
        "exportName": "gradientFeature",
        "requires": ["button.bg-color"],
        "props": [
          {
            "name": "gradient",
            "type": "boolean",
            "default": false
          },
          {
            "name": "gradientAngle",
            "type": "number",
            "default": 90
          }
        ]
      }
    }
  }
}
