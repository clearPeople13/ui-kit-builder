{
  "name": "semi",
  "components": "full",
  "prefix": "semi",
  "theme": {
    "global": {
      "colorPrimary": "#1664ff",
      "colorPrimaryLight": "#4d88ff",
      "colorPrimaryDark": "#0e50d9",
      "colorPrimaryBg": "#edf4ff",
      "colorPrimaryBgSubtle": "rgba(22, 100, 255, 0.06)",
      "colorPrimaryBorder": "#b3ccff",
      "colorSuccess": "#3cc780",
      "colorWarning": "#ff8a00",
      "colorDanger": "#f93920",
      "colorInfo": "#a9aeb8",
      "radiusSmall": "4px",
      "radiusBase": "8px",
      "radiusLarge": "12px",
      "radiusXl": "16px",
      "focusRing": "rgba(22, 100, 255, 0.12)",
      "focusRingSoft": "rgba(22, 100, 255, 0.06)"
    },
    "components": {
      "button": {
        "wave-animation": "ui-button-wave-semi 0.35s ease forwards",
        "wave-fade-duration": "0.35s",
        "wave-opacity": "0.3"
      }
    },
    "rawCss": "@keyframes ui-button-wave-semi {\n  0% { transform: scale(1); background: var(--ui-button-wave-color); opacity: var(--ui-button-wave-opacity, 0.3); }\n  45% { transform: scale(0.93); opacity: var(--ui-button-wave-opacity, 0.3); }\n  100% { transform: scale(1); opacity: 0; }\n}"
  }
}
