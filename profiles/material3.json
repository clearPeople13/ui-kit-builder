{
  "name": "material3",
  "label": "Material 3 谷歌",
  "order": 13,
  "components": "full",
  "prefix": "material3",
  "theme": {
    "global": {
      "colorPrimary": "#6750a4",
      "colorPrimaryLight": "#735cac",
      "colorPrimaryDark": "#564094",
      "colorPrimaryBg": "#eaddff",
      "colorPrimaryBgSubtle": "#f3edf7",
      "colorPrimaryBorder": "#cdc0e6",
      "colorSuccess": "#146c2e",
      "colorWarning": "#825500",
      "colorDanger": "#b3261e",
      "colorDangerBg": "#f9dedc",
      "colorInfo": "#625b71",
      "textColorPrimary": "#1c1b1f",
      "textColorRegular": "#49454f",
      "textColorPlaceholder": "#79747e",
      "radiusSmall": "6px",
      "radiusBase": "12px",
      "radiusLarge": "16px",
      "radiusXl": "28px",
      "fontFamily": "Roboto, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
      "shadowBase": "0 1px 2px rgba(0, 0, 0, 0.3), 0 1px 3px 1px rgba(0, 0, 0, 0.15)",
      "shadowMd": "0 4px 8px 3px rgba(0, 0, 0, 0.15), 0 1px 3px rgba(0, 0, 0, 0.3)",
      "shadowLg": "0 6px 10px 4px rgba(0, 0, 0, 0.15), 0 2px 3px rgba(0, 0, 0, 0.3)",
      "focusRing": "rgba(103, 80, 164, 0.2)",
      "focusRingSoft": "rgba(103, 80, 164, 0.1)"
    },
    "components": {
      "button": {
        "wave-animation": "ui-button-wave-ripple 0.6s cubic-bezier(0.08, 0.82, 0.17, 1) forwards, ui-button-wave-fade 0.8s cubic-bezier(0.08, 0.82, 0.17, 1) forwards",
        "wave-shadow": "none",
        "wave-color": "currentcolor",
        "wave-fade-duration": "0.8s",
        "wave-opacity": "0.4"
      }
    },
    "rawCss": "@property --ui-button-wave-r {\n  syntax: '<percentage>';\n  inherits: false;\n  initial-value: 0%;\n}\n@keyframes ui-button-wave-ripple {\n  to { --ui-button-wave-r: var(--ui-button-wave-ripple-size, 120%); }\n}\n@keyframes ui-button-wave-fade {\n  to { opacity: 0; }\n}"
  }
}
