{
  "name": "fluent",
  "label": "Fluent 2 微软",
  "order": 16,
  "components": "full",
  "prefix": "fluent",
  "theme": {
    "global": {
      "colorPrimary": "#0f6cbd",
      "colorPrimaryLight": "#115ea3",
      "colorPrimaryDark": "#0c3b5e",
      "colorPrimaryBg": "#ebf3fc",
      "colorPrimaryBgSubtle": "rgba(15, 108, 189, 0.06)",
      "colorPrimaryBorder": "#b4d0f0",
      "colorSuccess": "#107c41",
      "colorWarning": "#f7630c",
      "colorDanger": "#c50f1f",
      "colorInfo": "#8a8886",
      "radiusSmall": "2px",
      "radiusBase": "4px",
      "radiusLarge": "6px",
      "radiusXl": "8px",
      "focusRing": "rgba(15, 108, 189, 0.2)",
      "focusRingSoft": "rgba(15, 108, 189, 0.1)"
    },
    "components": {
      "button": {
        "wave-animation": "ui-button-wave-fluent 0.6s ease forwards",
        "wave-fade-duration": "0.6s",
        "wave-opacity": "0.4"
      }
    },
    "rawCss": "@keyframes ui-button-wave-fluent {\n  0% { box-shadow: 0 0 0 0 var(--ui-button-wave-color); opacity: var(--ui-button-wave-opacity, 0.4); }\n  100% { box-shadow: 0 0 10px 10px transparent; opacity: 0; }\n}"
  }
}
