{
  "name": "naive",
  "components": "full",
  "prefix": "naive",
  "theme": {
    "components": {
      "button": {
        "wave-animation": "ui-button-wave-press 0.3s ease forwards",
        "wave-color": "#ffffff",
        "wave-opacity": "0.25",
        "wave-fade-duration": "0.3s"
      }
    },
    "rawCss": "@keyframes ui-button-wave-press {\n  0% { transform: scale(1); background: var(--ui-button-wave-color); opacity: var(--ui-button-wave-opacity, 0.25); }\n  50% { transform: scale(0.94); opacity: var(--ui-button-wave-opacity, 0.25); }\n  100% { transform: scale(1); opacity: 0; }\n}",
    "global": {
      "colorPrimary": "#18a058",
      "colorPrimaryLight": "#36ad6a",
      "colorPrimaryDark": "#0c7a43",
      "colorPrimaryBg": "rgba(24, 160, 88, 0.1)",
      "colorPrimaryBgSubtle": "rgba(24, 160, 88, 0.05)",
      "colorPrimaryBorder": "rgba(24, 160, 88, 0.3)",
      "colorSuccess": "#18a058",
      "colorWarning": "#f0a020",
      "colorDanger": "#d03050",
      "colorInfo": "#909399",
      "radiusSmall": "3px",
      "radiusBase": "6px",
      "radiusLarge": "10px",
      "focusRing": "rgba(24, 160, 88, 0.15)",
      "focusRingSoft": "rgba(24, 160, 88, 0.08)"
    }
  }
}
