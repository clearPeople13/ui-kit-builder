{
  "name": "branded",
  "components": "full",
  "prefix": "acme",
  "theme": {
    "global": {
      "colorPrimary": "#0f766e",
      "colorPrimaryLight": "#14b8a6",
      "colorSuccess": "#059669",
      "colorWarning": "#d97706",
      "colorDanger": "#dc2626",
      "radiusBase": "8px",
      "fontSizeBase": "14px"
    },
    "components": {
      "button": {
        "radius": "10px",
        "wave-animation": "ui-button-wave-branded 0.7s ease forwards",
        "wave-fade-duration": "0.7s",
        "wave-opacity": "0.4"
      },
      "dialog": {
        "radius": "16px",
        "headerBg": "#f8fafc",
        "footerBg": "#f1f5f9"
      },
      "drawer": {
        "headerBg": "#f8fafc",
        "footerBg": "#f1f5f9"
      },
      "splitter": {
        "barBg": "#eef2f8",
        "barGrip": "#64748b"
      },
      "tag": {
        "radius": "999px"
      }
    },
    "rawCss": "@keyframes ui-button-wave-branded {\n  0% { box-shadow: 0 0 0 0 var(--ui-button-wave-color); opacity: var(--ui-button-wave-opacity, 0.4); }\n  100% { box-shadow: 0 0 14px 12px transparent; opacity: 0; }\n}"
  }
}
