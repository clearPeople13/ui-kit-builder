{
  "name": "tdesign",
  "components": "full",
  "prefix": "tdesign",
  "theme": {
    "global": {
      "colorPrimary": "#0052d9",
      "colorPrimaryLight": "#266fe8",
      "colorPrimaryDark": "#0034b5",
      "colorPrimaryBg": "#e3edff",
      "colorPrimaryBgSubtle": "rgba(0, 82, 217, 0.06)",
      "colorPrimaryBorder": "#b5cfff",
      "colorSuccess": "#00a870",
      "colorWarning": "#ed7b2f",
      "colorDanger": "#d54941",
      "colorInfo": "#a6a6a6",
      "radiusSmall": "3px",
      "radiusBase": "6px",
      "radiusLarge": "9px",
      "focusRing": "rgba(0, 82, 217, 0.15)",
      "focusRingSoft": "rgba(0, 82, 217, 0.08)"
    },
    "components": {
      "button": {
        "wave-animation": "ui-button-wave-tdesign 0.6s ease forwards",
        "wave-fade-duration": "0.6s",
        "wave-opacity": "0.4"
      }
    },
    "rawCss": "@keyframes ui-button-wave-tdesign {\n  0% { box-shadow: 0 0 0 0 var(--ui-button-wave-color); opacity: var(--ui-button-wave-opacity, 0.4); }\n  100% { box-shadow: 0 0 0 12px transparent; opacity: 0; }\n}"
  }
}
