{
  "name": "varlet",
  "label": "Varlet 移动端",
  "order": 11,
  "components": "full",
  "prefix": "varlet",
  "theme": {
    "global": {
      "colorPrimary": "#3a7afe",
      "colorPrimaryLight": "#629bfe",
      "colorPrimaryDark": "#2f6ae8",
      "colorPrimaryBg": "#ebf2ff",
      "colorPrimaryBgSubtle": "rgba(58, 122, 254, 0.06)",
      "colorPrimaryBorder": "#aecbfd",
      "colorSuccess": "#00c48f",
      "colorWarning": "#ff9f00",
      "colorDanger": "#f44336",
      "colorInfo": "#00afef",
      "radiusSmall": "6px",
      "radiusBase": "10px",
      "radiusLarge": "16px",
      "radiusXl": "22px",
      "focusRing": "rgba(58, 122, 254, 0.15)",
      "focusRingSoft": "rgba(58, 122, 254, 0.08)"
    },
    "components": {
      "button": {
        "wave-animation": "ui-button-wave-varlet 0.4s ease forwards",
        "wave-fade-duration": "0.4s",
        "wave-opacity": "0.3"
      }
    },
    "rawCss": "@keyframes ui-button-wave-varlet {\n  0% { box-shadow: inset 0 0 0 0 var(--ui-button-wave-color); background: var(--ui-button-wave-color); opacity: var(--ui-button-wave-opacity, 0.3); }\n  100% { box-shadow: inset 0 0 0 14px transparent; background: transparent; opacity: 0; }\n}"
  }
}
