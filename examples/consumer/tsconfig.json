{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src/usage.ts", "src/positive.vue", "src/demo/**/*.ts", "src/demo/**/*.vue"]
}
