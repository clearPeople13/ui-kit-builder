{
  "name": "ui-kit-feature-build-demo",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:core": "node scripts/build-lib.mjs --config profiles/core.json",
    "build:full": "node scripts/build-lib.mjs --config profiles/full.json",
    "build:branded": "node scripts/build-lib.mjs --config profiles/branded.json",
    "build:chinese": "node scripts/build-lib.mjs --config profiles/chinese.json",
    "build:cute": "node scripts/build-lib.mjs --config profiles/cute.json",
    "build:antd": "node scripts/build-lib.mjs --config profiles/antd.json",
    "build:arco": "node scripts/build-lib.mjs --config profiles/arco.json",
    "build:tdesign": "node scripts/build-lib.mjs --config profiles/tdesign.json",
    "build:naive": "node scripts/build-lib.mjs --config profiles/naive.json",
    "build:viewui": "node scripts/build-lib.mjs --config profiles/viewui.json",
    "build:vant": "node scripts/build-lib.mjs --config profiles/vant.json",
    "build:varlet": "node scripts/build-lib.mjs --config profiles/varlet.json",
    "build:semi": "node scripts/build-lib.mjs --config profiles/semi.json",
    "build:material3": "node scripts/build-lib.mjs --config profiles/material3.json",
    "build:bootstrap": "node scripts/build-lib.mjs --config profiles/bootstrap.json",
    "build:shadcn": "node scripts/build-lib.mjs --config profiles/shadcn.json",
    "build:fluent": "node scripts/build-lib.mjs --config profiles/fluent.json",
    "build:carbon": "node scripts/build-lib.mjs --config profiles/carbon.json",
    "build:mantine": "node scripts/build-lib.mjs --config profiles/mantine.json",
    "build:ios": "node scripts/build-lib.mjs --config profiles/ios.json",
    "build:all": "node scripts/build-all.mjs",
    "meta:demo": "node scripts/generate-demo-meta.mjs",
    "sync:consumer-deps": "node scripts/sync-consumer-deps.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/ui-kit/src/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"registry.mjs\" \"configurator/**/*.{js,css,html}\" \"index.html\" \"examples/consumer/*.mjs\" \"examples/consumer/scripts/**/*.mjs\" \"examples/consumer/**/*.html\" \"examples/consumer/**/*.css\" \"examples/consumer/src/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"vitest.*.config.ts\"",
    "format:check": "prettier --check \"packages/ui-kit/src/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"registry.mjs\" \"configurator/**/*.{js,css,html}\" \"index.html\" \"examples/consumer/*.mjs\" \"examples/consumer/scripts/**/*.mjs\" \"examples/consumer/**/*.html\" \"examples/consumer/**/*.css\" \"examples/consumer/src/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"vitest.*.config.ts\"",
    "verify": "node scripts/verify.mjs",
    "verify:governance": "node scripts/verify-governance.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "verify:reuse": "node scripts/verify.mjs --reuse",
    "verify:if-fresh": "node scripts/verify.mjs --reuse --if-fresh",
    "pretest": "npm run build:full",
    "test": "vitest run",
    "test:unit": "vitest run",
    "pretest:build": "npm run build:all",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:build:run": "vitest run --config vitest.build.config.ts",
    "pretest:profiles": "npm run build:all",
    "test:profiles": "vitest run --config vitest.profiles.config.ts",
    "test:profiles:run": "vitest run --config vitest.profiles.config.ts",
    "pretest:browser": "npm run build:full",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:run": "vitest run --config vitest.browser.config.ts",
    "snap:layout": "node scripts/update-layout-snapshot.mjs",
    "snap:pixels": "node scripts/update-pixel-snapshot.mjs",
    "test:all": "node scripts/ci.mjs",
    "quality": "node scripts/ci.mjs",
    "ci": "node scripts/ci.mjs",
    "ci:fast": "node scripts/ci.mjs --fast",
    "ci:changed": "node scripts/ci.mjs --changed",
    "ci:plan": "node scripts/ci.mjs --changed --dry",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build:full",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:coverage:run": "vitest run --coverage --config vitest.coverage.config.ts",
    "verify:consumer": "npm --prefix examples/consumer run check:all",
    "demo:consumer": "npm --prefix examples/consumer run dev",
    "guardian": "node tools/guardian/guardian.mjs",
    "guardian:once": "node tools/guardian/guardian.mjs --once"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "chroma-js": "3.2.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/chroma-js": "3.1.3",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.0",
    "happy-dom": "^21.0.4",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  }
}
